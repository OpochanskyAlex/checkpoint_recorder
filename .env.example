# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Required in production (webhook mode). Not needed for local docker-compose (polling mode).
# WEBHOOK_URL=https://your-app.up.railway.app
# WEBHOOK_SECRET=generate_a_random_secret_here

# Supabase / PostgreSQL
# Use the "Transaction" pooler URL from Supabase for asyncpg
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql+psycopg2://user:password@host:port/dbname

# Server
PORT=8080

# Tunable thresholds (SU-001, SU-002, SU-006, SU-009)
NLP_CONFIDENCE_THRESHOLD=0.65
PARSE_ATTEMPT_EXPIRY_HOURS=24
PERIODICITY_PROMPT_EXPIRY_HOURS=24
DEFERRED_CLEANUP_DAYS=30
PARSE_ATTEMPT_DANGLING_DETECTION_SECONDS=30
SCHEDULER_INTERVAL_HOURS=12

LOG_LEVEL=INFO
